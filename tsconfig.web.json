{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "noEmit": true
  },
  "include": [
    "src/renderer/src/**/*",
    "src/engine/**/*",
    "src/importer/types.ts",
    "src/importer/reconcile.ts",
    "src/main/navTypes.ts"
  ]
}
